# Environment variables
# Copy this file to .env and update with your actual values

# =============================================================================
# FRONTEND ENVIRONMENT VARIABLES (for Next.js/Vercel)
# =============================================================================
# These should be set in Vercel project settings

# Backend API URL - Point to your deployed backend (Railway/Render/VPS)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# =============================================================================
# BACKEND ENVIRONMENT VARIABLES (for Express server)
# =============================================================================
# These should be set in your backend hosting platform (Railway/Render/etc.)

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
# For production, use MongoDB Atlas connection string
# Example: mongodb+srv://username:password@cluster.mongodb.net/mediacareers?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/mediacareers

# JWT Configuration
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=90d

# Email Configuration (for welcome emails and notifications)
# Use SMTP service like Gmail, SendGrid, Mailgun, etc.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=noreply@mediacareers.in

# OpenAI Configuration (for AI features)
OPENAI_API_KEY=your_openai_api_key_here

# UPI Payment Configuration
UPI_ID=info@phildass.com
UPI_NAME=MediaCareers

# Application Configuration
APP_URL=http://localhost:3000
PREMIUM_PRICE=199
PREMIUM_DURATION_MONTHS=3
FREE_MEMBERSHIP_EXPERIENCE_MONTHS=12

# File Upload Configuration
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=.pdf,.doc,.docx

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# DEPLOYMENT-SPECIFIC VARIABLES
# =============================================================================
# These are typically set in your deployment platform

# For Vercel deployment (GitHub Actions)
# VERCEL_TOKEN=your_vercel_token_here
# VERCEL_ORG_ID=your_vercel_org_id_here
# VERCEL_PROJECT_ID=your_vercel_project_id_here
